= content_for :title, @cookbook.name

= page_header @cookbook.name

.index-columns
  - @cookbook.sections.by_position.each_with_index do |section, i|
    %section.index-section{ class: Section.hue_class_for(i) }
      %h2.index-section-title
        %span.section-mark
        %span.index-section-name= section.name
      .index-section-rows
        - section.recipes.bases_only.includes(:variants).with_thumbs.abc.each do |recipe|
          = render 'recipes/family', recipe:, public: true
