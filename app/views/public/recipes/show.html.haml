= content_for :title, @recipe.display_name

= page_header @recipe.display_name, back: [@recipe.cookbook.name, [:public, @recipe.cookbook]], eyebrow: @recipe.section&.name, summary: @recipe.book_source do
  - if @recipe.link
    = link_to 'Open recipe ↗', @recipe.link, class: 'btn btn-secondary', target: '_blank', rel: 'noopener'

- kind = recipe_body_kind(@recipe)
- if kind.in?(%i[structured prose])
  %article.panel.recipe-body{ class: ["recipe-body--#{kind}", @recipe.section&.hue_class] }
    = @recipe.instructions
