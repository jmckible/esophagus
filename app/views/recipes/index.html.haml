= content_for :title, 'Recipes'

.recipe-index{ data: { controller: 'recipe-index', action: 'keydown@window->recipe-index#shortcut scroll@window->recipe-index#track' } }
  .index-head
    %h1
      Recipes
      %span.mono.index-total= @sections.sum(&:count)

  .index-bar{ data: { recipe_index_target: 'bar' } }
    .index-bar-inner
      %button.index-current{ type: 'button', data: { action: 'recipe-index#openSheet' }, 'aria-haspopup': 'dialog' }
        %span.section-mark{ data: { recipe_index_target: 'currentMark' } }
        %span{ data: { recipe_index_target: 'currentName' } }= @sections.first&.name
        = chevron_down
      %label.index-find
        %svg{ width: 16, height: 16, viewBox: '0 0 24 24', fill: 'none', stroke: 'currentColor', 'stroke-width': 2.2, 'stroke-linecap': 'round', 'aria-hidden': true }
          %circle{ cx: 11, cy: 11, r: 7 }
          %path{ d: 'M20 20l-3.5-3.5' }
        %span.visually-hidden Find a recipe
        %input{ type: 'search', placeholder: 'Find a recipe', autocomplete: 'off', data: { recipe_index_target: 'find', action: 'input->recipe-index#filter keydown.esc->recipe-index#clear' } }
        %kbd.mono /

  .index-columns
    - @sections.each do |section|
      %section.index-section{ id: section.dom_id, class: section.hue_class, data: { recipe_index_target: 'section', name: section.name, hue: section.hue_class } }
        %h2.index-section-title
          %span.section-mark
          %span.index-section-name= section.name
          %span.mono= section.count
        .index-section-rows
          - section.recipes.each do |recipe|
            = render 'recipes/family', recipe:
  %p.empty-state{ hidden: true, data: { recipe_index_target: 'empty' } } No recipes match.

  %dialog.index-sheet{ 'aria-label': 'Jump to section', data: { recipe_index_target: 'sheet', action: 'click->recipe-index#closeOnBackdrop' } }
    .index-sheet-head
      %h2 Sections
      %button.text-link{ type: 'button', data: { action: 'recipe-index#top' } } Back to top
    %nav{ 'aria-label': 'Sections' }
      - @sections.each do |section|
        = link_to "##{section.dom_id}", class: ['index-sheet-link', section.hue_class], data: { action: 'recipe-index#jump', name: section.name } do
          %span.section-mark
          %span.index-sheet-name= section.name
          %span.mono= section.count
