- content_for :page_class, 'page--narrow'
= content_for :title, "Edit #{@recipe.display_name}"

- summary = @recipe.parent ? "Variant of #{@recipe.parent.name}" : [pluralize(@recipe.cooks.count, 'cook'), (pluralize(@recipe.variants.count, 'variant') if @recipe.variants.any?)].compact.join(' · ')
= page_header 'Edit recipe', back: [@recipe.display_name, @recipe], summary: summary do
  = button_to 'Delete', @recipe, method: :delete, class: 'btn btn-danger', data: { turbo_confirm: 'Are you sure? This cannot be undone.' }

= render 'form', recipe: @recipe
