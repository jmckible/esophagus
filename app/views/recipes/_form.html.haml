- if recipe.errors.any?
  .form-errors
    %h2
      = pluralize(recipe.errors.count, 'error')
      prevented this recipe from being saved:
    %ul
      - recipe.errors.full_messages.each do |message|
        %li= message

= form_with model: recipe do |f|
  .panel
    .panel-header
      %h2.panel-title Basic info
    .panel-body
      .form-group
        = f.label :name, class: 'form-label'
        = f.text_field :name, class: 'form-control', placeholder: 'Recipe name'

      .form-row
        .form-group
          = f.label :section_id, 'Section', class: 'form-label'
          = f.collection_select :section_id, Current.cookbook.sections.by_position, :id, :name, { include_blank: 'Uncategorized' }, { class: 'form-control' }

        .form-group
          = f.label :parent_id, 'Variant of', class: 'form-label'
          - locked = recipe.persisted? && recipe.variants.any?
          = f.collection_select :parent_id, Current.cookbook.recipes.bases_only.where(section: recipe.section).abc, :id, :name, { include_blank: 'None (base recipe)' }, { class: 'form-control', disabled: locked }
          - if locked
            .form-help Can't change: this recipe has variants

      .form-group
        = f.label :link, 'External link', class: 'form-label'
        = f.text_field :link, class: 'form-control', placeholder: 'https://example.com/recipe'

      .form-row
        .form-group
          = f.label :book_name, 'Book', class: 'form-label'
          = f.text_field :book_name, class: 'form-control', list: 'books', autocomplete: 'off', placeholder: 'Printed cookbook'
          %datalist#books
            - Current.cookbook.books.abc.each do |book|
              %option{ value: book.name }
        .form-group.form-group--narrow
          = f.label :book_page, 'Page', class: 'form-label'
          = f.number_field :book_page, class: 'form-control', min: 1

      .form-group
        = f.label :kid_status, 'Kid status', class: 'form-label'
        = f.select :kid_status, Recipe.kid_statuses.keys.map { |status| [status.humanize, status] }, { include_blank: 'Not set' }, { class: 'form-control' }

  .panel
    .panel-header
      %h2.panel-title Photo
    .panel-body
      - if recipe.photo.attached?
        = image_tag recipe.photo.variant(:header), class: 'form-photo', alt: ''
      .form-group
        = f.label :photo, (recipe.photo.attached? ? 'Replace photo' : 'Photo'), class: 'form-label'
        = f.file_field :photo, accept: 'image/*', class: 'form-control'
      - if recipe.photo.attached?
        %label.form-check
          = f.check_box :remove_photo
          Remove photo

  .panel
    .panel-header
      %h2.panel-title Instructions
    .panel-body
      = f.rich_text_area :instructions

  .form-actions
    = f.submit (recipe.persisted? ? 'Save changes' : 'Create recipe'), class: 'btn btn-primary'
    = link_to 'Cancel', (recipe.persisted? ? recipe : root_path), class: 'btn btn-secondary'
