= content_for :title, @recipe.display_name

.recipe{ class: @recipe.section&.hue_class }
  %section.panel.recipe-head
    .recipe-head-top
      .recipe-head-title
        .chips
          - if @recipe.section
            = link_to root_path(anchor: "section-#{@recipe.section.id}"), class: 'chip chip-section' do
              %span.section-mark
              = @recipe.section.name
          - if @recipe.favorite?
            %span.chip.chip-ink Favorite
          - if @recipe.parent
            = link_to "Variant of #{@recipe.parent.name}", @recipe.parent, class: 'chip'
        %h1.recipe-title= @recipe.display_name
      #cook-form.recipe-head-log
        = render 'recipes/cook_form', recipe: @recipe
    .recipe-head-foot
      %dl#recipe-stats.recipe-stats
        = render 'recipes/stats', recipe: @recipe
      = link_to 'Edit', [:edit, @recipe], class: 'text-link'

  - case recipe_body_kind(@recipe)
  - when :structured, :prose
    %article.panel.recipe-body{ class: "recipe-body--#{recipe_body_kind(@recipe)}" }
      = @recipe.instructions
  - when :link
    %section.panel.recipe-source
      %p.label Recipe at
      %p.recipe-source-host= link_host(@recipe.link)
      %p.recipe-source-url.mono= @recipe.link
      .recipe-source-actions
        = link_to 'Open recipe ↗', @recipe.link, class: 'btn btn-ink', target: '_blank', rel: 'noopener'
        = link_to 'Add instructions', [:edit, @recipe], class: 'text-link'
  - else
    %section.panel.recipe-source
      %p.recipe-source-host No instructions yet
      .recipe-source-actions
        = link_to 'Add instructions', [:edit, @recipe], class: 'btn btn-secondary'

  %section.panel#cook-history
    = render 'recipes/cook_history', recipe: @recipe
