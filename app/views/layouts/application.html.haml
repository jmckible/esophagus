!!! 5
%html{ lang: 'en '}
  %head
    %title= yield :title
    = csrf_meta_tags
    = csp_meta_tag
    = action_cable_meta_tag
    = turbo_refreshes_with method: :morph, scroll: :preserve
    = stylesheet_link_tag 'application', 'data-turbolinks-track': 'reload'
    = javascript_importmap_tags
    %link{ rel: 'icon', href: '/icon.svg', type: 'image/svg+xml' }
    %meta{ charset: 'utf8' }
    %meta{ name: 'viewport', content: 'width=device-width, initial-scale=1, shrink-to-fit=no' }
    %meta{ name: 'theme-color', content: '#000000' }
    %meta{ name: 'apple-mobile-web-app-capable', content: 'yes' }
    %meta{ name: 'apple-mobile-web-app-status-bar-style', content: 'default' }
    %link{ rel: 'manifest', href: '/manifest.json' }
    %link{ rel: 'apple-touch-icon', sizes: '180x180', href: '/apple-touch-icon.png' }
    :javascript
      if ("serviceWorker" in navigator) {
        navigator.serviceWorker.register("/service-worker.js")
      }

      // Standalone PWAs get killed in the background and relaunch at start_url.
      // sessionStorage is empty on a cold launch, so use it to tell a relaunch
      // apart from navigating home, and restore the last page if it's recent.
      (function() {
        if (!window.matchMedia("(display-mode: standalone)").matches) return
        try {
          var key = "pwa:last-location", maxAge = 12 * 60 * 60 * 1000
          if (!sessionStorage.getItem("pwa:launched")) {
            sessionStorage.setItem("pwa:launched", "1")
            var last = JSON.parse(localStorage.getItem(key) || "null")
            if (location.pathname === "/" && last && Date.now() - last.at < maxAge && last.url !== "/") {
              location.replace(last.url)
              return
            }
          }
          document.addEventListener("turbo:load", function() {
            localStorage.setItem(key, JSON.stringify({ url: location.pathname + location.search, at: Date.now() }))
          })
        } catch (e) {}
      })()


  %body
    .page-container
      - if flash[:notice]
        .alert.alert-success{ data: { turbo_temporary: true } }
          = flash[:notice]
      - if flash[:alert]
        .alert.alert-danger{ data: { turbo_temporary: true } }
          = flash[:alert]
      = yield
