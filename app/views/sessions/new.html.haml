- content_for :page_class, 'page--narrow'
= content_for :title, 'Log in'

= page_header 'Log in'

= form_with url: authenticate_path do |f|
  .form-group
    = f.label :email, class: 'form-label'
    = f.email_field :email, class: 'form-control', autocomplete: 'username'
  .form-group
    = f.label :password, class: 'form-label'
    = f.password_field :password, class: 'form-control', autocomplete: 'current-password'
  = f.submit 'Log in', class: 'btn btn-primary'
