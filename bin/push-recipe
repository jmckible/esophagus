#!/bin/bash
# Copy recipes from the dev database to production:
#   bin/push-recipe 6 [12 ...]
# Instructions and the source link always move; the photo moves when dev has
# one and it differs from production's. The name must match on both sides.
# Whatever production had is saved to tmp/backups first.
#
# Production runs on this machine, so the recipe goes to its container over
# docker exec stdin: a photo is too big for a command-line argument.
set -euo pipefail

mkdir -p tmp/backups

container=$(docker ps --filter label=service=esophagus --filter label=role=web --filter status=running --format '{{.Names}}' | head -1)
if [[ -z $container ]]; then
  echo "No running esophagus web container" >&2
  exit 1
fi

for id in "$@"; do
  if [[ ! $id =~ ^[0-9]+$ ]]; then
    echo "Not a recipe id: $id" >&2
    exit 1
  fi

  payload=$(mktemp)
  bin/rails runner "
    r = Recipe.find($id)
    payload = { id: r.id, name: r.name, link: r.link, instructions: r.instructions.body.to_html }
    if r.photo.attached?
      payload[:photo] = { filename: r.photo.filename.to_s, content_type: r.photo.content_type, checksum: r.photo.checksum, data: Base64.strict_encode64(r.photo.download) }
    end
    print payload.to_json
  " > "$payload"

  if ! output=$(docker exec -i "$container" bin/rails recipes:import < "$payload" 2>&1) \
     || ! grep -q '^Updated ' <<< "$output"; then
    rm -f "$payload"
    echo "$output" >&2
    exit 1
  fi
  rm -f "$payload"

  backup="tmp/backups/recipe-$id-$(date +%Y%m%d-%H%M%S)"
  grep '^BACKUP ' <<< "$output" | cut -d' ' -f2- > "$backup.json"
  grep '^Updated ' <<< "$output"
  echo "  previous production copy: $backup.json"
done
